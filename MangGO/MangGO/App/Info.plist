<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Wajib sejak iOS 14 supaya MultipeerConnectivity boleh menemukan peer.
	     Harus cocok persis dengan StationSync.serviceType, dan _tcp maupun
	     _udp dua-duanya harus ada. Tanpa ini iPhone dan iPad tidak akan pernah
	     saling menemukan, dan iOS tidak memberi error apa pun. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_manggo-sync._tcp</string>
		<string>_manggo-sync._udp</string>
	</array>
</dict>
</plist>
